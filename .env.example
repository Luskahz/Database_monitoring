# Servidor HTTP
PORT=3000

# Monitoramento de diretórios
MONITOR_PATH=\\\\192.168.0.213\\Files\\Logistica\\0.DPO\\Diretórios_SQL

# Banco de dados
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=database_name
DB_PORT=3306
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_MS=60000
DB_QUERY_TIMEOUT_MS=120000

# Pipeline de ingestão
PIPELINE_FAST_PATH=false
BATCH_SIZE=5000
MAX_CONCURRENT_INSERTS=1
FILES_MAX_CONCURRENT=4
QUEUE_HIGH_WATERMARK=4
QUEUE_LOW_WATERMARK=2
MAX_BATCH_BYTES=50331648          # 48 * 1024 * 1024
MAX_BATCH_BYTES_WHEN_HIGH=16777216 # 16 * 1024 * 1024

# Monitoramento awaitWriteFinish
AWF_STABILITY_MS=1500
AWF_POLL_MS=100

# Controle adaptativo de memória
ADAPTIVE_RAM_GUARD=1
RAM_HIGH_MB=2048
RAM_LOW_MB=1536
RAM_GUARD_INTERVAL_MS=1000

# Diretório de staging local
STAGING_DIR=./staging
STAGING_REUSE=1
STAGING_VERIFY=1
STAGING_CLEANUP_ON_SUCCESS=1
STAGING_CLEANUP_TTL_MIN=60

# Logger
LOG_FLUSH_MS=200
LOG_FLUSH_LINES=100
LOG_CLOSE_TIMEOUT_MS=5000
PERF_LOGS=true