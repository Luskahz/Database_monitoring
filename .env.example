# =========================
# DATABASE MONITORING ENV EXAMPLE
# =========================
# Copie este arquivo para ".env" dentro de:
# LogImarui/logimarui-services/database-monitoring/.env
#
# A porta NÃO fica neste arquivo.
# Quando iniciado pelo Java supervisor, PORT é injetado pelo processo pai.
# Para rodar manualmente, o server deve usar fallback local no código.

# ========= MONITORAMENTO DE DIRETÓRIOS =========
MONITOR_PATH=S:\Logistica\0.DPO\Diretórios_SQL

# ========= BANCO DE DADOS =========
DB_HOST=localhost
DB_PORT=3306
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=diretorio

DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_IDLE_MS=60000
DB_QUERY_TIMEOUT_MS=120000

# ========= PIPELINE DE INGESTÃO =========
PIPELINE_FAST_PATH=false
BATCH_SIZE=5000
MAX_CONCURRENT_INSERTS=12
FILES_MAX_CONCURRENT=10
QUEUE_HIGH_WATERMARK=4
QUEUE_LOW_WATERMARK=2
MAX_BATCH_BYTES=50331648
MAX_BATCH_BYTES_WHEN_HIGH=16777216

# ========= AWAIT WRITE FINISH =========
AWF_STABILITY_MS=1500
AWF_POLL_MS=100

# ========= CONTROLE ADAPTATIVO DE MEMÓRIA =========
ADAPTIVE_RAM_GUARD=1
RAM_HIGH_MB=4048
RAM_LOW_MB=1536
RAM_GUARD_INTERVAL_MS=1000

# ========= STAGING LOCAL =========
STAGING_DIR=./staging
STAGING_REUSE=1
STAGING_VERIFY=1
STAGING_CLEANUP_ON_SUCCESS=1
STAGING_CLEANUP_TTL_MIN=60

# ========= LOGGER =========
LOG_FLUSH_MS=200
LOG_FLUSH_LINES=100
LOG_CLOSE_TIMEOUT_MS=5000
PERF_LOGS=false